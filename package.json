{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "build": "nx build",
    "build:wasm": "cd walletd && GOOS=js GOARCH=wasm go build -o ../apps/walletd/public/walletd.wasm ./wasm",
    "clean": "bunx rimraf dist apps/*/node_modules libs/*/node_modules apps/*/.next .nx playwright-report && nx reset && bun i",
    "release": "changeset publish",
    "sort": "bunx sort-package-json && find apps libs -type f -name package.json -depth 2 -execdir bunx sort-package-json \\;",
    "start": "nx serve",
    "test": "nx test",
    "version": "changeset version && bun install"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@nx-tools/nx-container": "^7.3.0",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/next": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/react": "23.1.1",
    "@nx/rollup": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@playwright/test": "^1.62.1",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@swc/helpers": "0.5.23",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/carbon__icons-react": "^11.29.4",
    "@types/jest": "^30.0.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "autoprefixer": "10.5.4",
    "babel-jest": "^30.4.1",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "file-loader": "^6.2.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-fixed-jsdom": "^0.0.11",
    "nx": "23.1.1",
    "playwright": "^1.62.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "tailwindcss": "4.3.3",
    "ts-jest": "^29.4.12",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
